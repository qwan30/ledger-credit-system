{
  "name": "ledger-credit-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api-contracts"
  ],
  "description": "Finance backend with append-only ledger, idempotent transfers, manual credit review, and batch processing.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:legacy": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "lint:legacy": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:legacy": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run src",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --fileParallelism=false",
    "test:integration": "vitest run tests/integration --fileParallelism=false",
    "test:e2e": "npm run test:integration",
    "benchmark:batch": "tsx scripts/benchmark-batch.ts",
    "benchmark:batch:smoke": "tsx scripts/benchmark-batch.ts 5000",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "contracts:generate": "npm run generate --workspace @ledger-credit-system/api-contracts",
    "contracts:check": "npm run check --workspace @ledger-credit-system/api-contracts",
    "web:dev": "npm run dev --workspace @ledger-credit-system/web",
    "web:build": "npm run build --workspace @ledger-credit-system/web",
    "web:lint": "npm run lint --workspace @ledger-credit-system/web",
    "web:typecheck": "npm run typecheck --workspace @ledger-credit-system/web",
    "web:test": "npm run test --workspace @ledger-credit-system/web",
    "java:test": "mvn -f apps/api-java/pom.xml test",
    "java:package": "mvn -f apps/api-java/pom.xml package",
    "verify:full": "tsx scripts/verify-full.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/view": "^11.1.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.6.0",
    "jose": "^6.2.1",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.14.1",
    "pg-boss": "^10.1.6",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "openapi-typescript": "^7.7.0",
    "prisma": "^6.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
